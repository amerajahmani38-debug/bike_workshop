<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bike_workshop.BikeDashboardTemplate">
        <div class="o_bike_dashboard p-4">
            <h2 class="mb-4">Bike Workshop Dashboard</h2>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card text-white bg-primary" style="cursor:pointer;" t-on-click="openActiveRentals">
                        <div class="card-body">
                            <h5 class="card-title">Active Rentals</h5>
                            <h1 class="card-text" t-esc="state.activeRentals"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card text-white bg-warning" style="cursor:pointer;" t-on-click="openReturnsDue">
                        <div class="card-body">
                            <h5 class="card-title">Returns Due</h5>
                            <h1 class="card-text" t-esc="state.returnsDue"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card text-white bg-danger" style="cursor:pointer;" t-on-click="openRepairsInProgress">
                        <div class="card-body">
                            <h5 class="card-title">Repairs In Progress</h5>
                            <h1 class="card-text" t-esc="state.repairsInProgress"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>