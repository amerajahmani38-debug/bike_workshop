<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Repair Search View -->
    <record id="view_bike_repair_search" model="ir.ui.view">
        <field name="name">bike.repair.search</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <search string="Search Repairs">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="workshop_bike_id"/>
                <field name="mechanic_id"/>
                <field name="state"/>
                <separator/>
                <!-- Status Filters -->
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <!-- Group By Options -->
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Bike Source" name="group_by_bike_source" context="{'group_by': 'bike_source'}"/>
                    <filter string="Mechanic" name="group_by_mechanic" context="{'group_by': 'mechanic_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Repair Kanban View -->
    <record id="view_bike_repair_kanban" model="ir.ui.view">
        <field name="name">bike.repair.kanban</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="badge rounded-pill text-bg-secondary"><field name="state"/></span>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><strong>Customer:</strong> <field name="customer_id"/></div>
                                <div><strong>Mechanic:</strong> <field name="mechanic_id"/></div>
                                <div><strong>Source:</strong> <field name="bike_source"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_right">
                                    <strong><field name="total_parts_cost"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Repair Form View -->
    <record id="view_bike_repair_form" model="ir.ui.view">
        <field name="name">bike.repair.form</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <form string="Repair Job">
                <header>
                    <button name="action_start" string="Start Repair" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="bike_source" widget="radio"/>
                            <field name="workshop_bike_id" invisible="bike_source != 'workshop'" required="bike_source == 'workshop'"/>
                            <field name="external_bike_name" invisible="bike_source != 'external'" required="bike_source == 'external'"/>
                            <field name="external_bike_brand" invisible="bike_source != 'external'"/>
                            <field name="external_bike_type" invisible="bike_source != 'external'"/>
                        </group>
                        <group>
                            <field name="mechanic_id"/>
                            <field name="last_service_date"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reported_issue"/>
                        <field name="service_notes"/>
                    </group>
                    <notebook>
                        <page string="Spare Parts">
                            <field name="repair_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'quick_create': False}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_parts_cost" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Repair List View -->
    <record id="view_bike_repair_tree" model="ir.ui.view">
        <field name="name">bike.repair.tree</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <list string="Repair Jobs" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_source"/>
                <field name="mechanic_id"/>
                <field name="last_service_date"/>
                <field name="total_parts_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Actions for Repairs -->
    <record id="action_bike_repair" model="ir.actions.act_window">
        <field name="name">Repair Jobs</field>
        <field name="res_model">bike.repair</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_bike_repair_search"/>
    </record>

    <!-- Actions for Bikes (تمت إضافتها هنا لحل الخطأ نهائياً) -->
    <record id="action_bike_workshop_bike" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_workshop_root" 
              name="Bike Workshop" 
              sequence="10"/>

    <!-- قائمة الدراجات الرئيسية -->
    <menuitem id="menu_bike_workshop_bikes" 
              name="Bikes" 
              parent="menu_bike_workshop_root" 
              action="action_bike_workshop_bike" 
              sequence="20"/>

    <!-- قائمة الإصلاحات الفرعية -->
    <menuitem id="menu_bike_repair_root" 
              name="Repairs" 
              parent="menu_bike_workshop_root" 
              sequence="30"/>

    <menuitem id="menu_bike_repair_all" 
              name="All Repairs" 
              parent="menu_bike_repair_root" 
              action="action_bike_repair" 
              sequence="10"/>
</odoo>