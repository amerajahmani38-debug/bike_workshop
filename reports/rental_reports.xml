<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bike_rental_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id if 'company_id' in doc._fields and doc.company_id else res_company"/>
                <t t-call="web.external_layout">
                    <div class="page" style="max-width: 800px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">

                        <!-- Report title -->
                        <div style="text-align: right; margin-bottom: 25px;">
                            <h3 style="margin: 0; color: #0056b3;">Rental Agreement</h3>
                        </div>

                        <!-- تفاصيل الإيجار -->
                        <table style="width: 100%; margin-bottom: 30px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%; vertical-align: top; padding: 0;">
                                    <p style="margin: 5px 0;"><strong>Rental Reference:</strong> <span t-esc="doc.reference"/></p>
                                    <p style="margin: 5px 0;"><strong>Status:</strong> <span t-esc="doc.state" style="text-transform: capitalize;"/></p>
                                    <p style="margin: 5px 0;"><strong>Customer:</strong> <span t-esc="doc.customer_id.name"/></p>
                                </td>
                                <td style="width: 50%; vertical-align: top; padding: 0; text-align: right;">
                                    <p style="margin: 5px 0;"><strong>Rented Bike:</strong> <span t-esc="doc.bike_id.name"/></p>
                                    <p style="margin: 5px 0;"><strong>Start Date:</strong> <span t-field="doc.start_date"/></p>
                                    <p style="margin: 5px 0;"><strong>Expected Return:</strong> <span t-field="doc.expected_return_date"/></p>
                                    <t t-if="doc.actual_return_date">
                                        <p style="margin: 5px 0; color: #28a745;"><strong>Actual Return Date:</strong> <span t-field="doc.actual_return_date"/></p>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- جدول التفاصيل -->
                        <table class="table table-bordered" style="width: 100%; border-collapse: collapse; margin-top: 20px;" border="1">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="padding: 12px; text-align: left;">Description</th>
                                    <th style="padding: 12px; text-align: center;">Duration</th>
                                    <th style="padding: 12px; text-align: right;">Daily Price</th>
                                    <th style="padding: 12px; text-align: right;">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 12px;">Rental of Bike: <span t-esc="doc.bike_id.name"/></td>
                                    <td style="padding: 12px; text-align: center;"><span t-esc="doc.rental_duration"/> days</td>
                                    <td style="padding: 12px; text-align: right;"><span t-esc="doc.daily_rental_price"/> JD</td>
                                    <td style="padding: 12px; text-align: right;"><span t-esc="doc.total_amount"/> JD</td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- المجموع الكلي -->
                        <div style="margin-top: 30px; text-align: right; border-top: 1px solid #ddd; padding-top: 15px;">
                            <h3 style="margin: 0;"><strong>Total Rental Amount: <span t-esc="doc.total_amount"/> JD</strong></h3>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>