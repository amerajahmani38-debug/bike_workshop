<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_bike_rental_search" model="ir.ui.view">
        <field name="name">bike.rental.search</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <search string="Search Rentals">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Returned" name="filter_returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Bike" name="group_by_bike" context="{'group_by': 'bike_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View for Rentals -->
    <record id="view_bike_rental_kanban" model="ir.ui.view">
        <field name="name">bike.rental.kanban</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="reference"/></strong>
                                </div>
                                <span class="badge rounded-pill text-bg-secondary"><field name="state"/></span>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><strong>Customer:</strong> <field name="customer_id"/></div>
                                <div><strong>Bike:</strong> <field name="bike_id"/></div>
                                <div><strong>Start:</strong> <field name="start_date"/></div>
                                <div><strong>Expected Return:</strong> <field name="expected_return_date"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_right">
                                    <strong><field name="total_amount"/> JD</strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View for Rentals -->
    <record id="view_bike_rental_graph" model="ir.ui.view">
        <field name="name">bike.rental.graph</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <graph string="Rentals Analysis" type="bar">
                <field name="start_date" interval="month"/>
                <field name="total_amount" type="measure" operator="sum"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Rentals -->
    <record id="view_bike_rental_pivot" model="ir.ui.view">
        <field name="name">bike.rental.pivot</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <pivot string="Rentals Analysis">
                <field name="customer_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_amount" type="measure" operator="sum"/>
            </pivot>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bike_rental_form" model="ir.ui.view">
        <field name="name">bike.rental.form</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <form string="Bike Rental">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" string="Return" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('returned', 'cancelled')"/>
                    <button name="action_print_rental_agreement" string="Print Rental Agreement" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="bike_id"/>
                            <field name="daily_rental_price"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date" invisible="state != 'returned'"/>
                            <field name="rental_duration"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bike_rental_tree" model="ir.ui.view">
        <field name="name">bike.rental.tree</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <list string="Bike Rentals" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'returned'" decoration-danger="state == 'cancelled'">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="rental_duration"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_bike_rental_all" model="ir.actions.act_window">
        <field name="name">All Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_bike_rental_search"/>
    </record>

    <record id="action_bike_rental_confirmed" model="ir.actions.act_window">
        <field name="name">Confirmed Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="search_view_id" ref="view_bike_rental_search"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_rental_root" 
              name="Rentals" 
              parent="menu_bike_workshop_root" 
              sequence="20"/>

    <menuitem id="menu_bike_rental_all" 
              name="All Rentals" 
              parent="menu_bike_rental_root" 
              action="action_bike_rental_all" 
              sequence="10"/>

    <menuitem id="menu_bike_rental_confirmed" 
              name="Confirmed Rentals" 
              parent="menu_bike_rental_root" 
              action="action_bike_rental_confirmed" 
              sequence="20"/>

    <!-- Report Action -->
    <record id="action_report_bike_rental" model="ir.actions.report">
        <field name="name">Rental Agreement</field>
        <field name="model">bike.rental</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bike_workshop.report_bike_rental_document</field>
        <field name="report_file">bike_workshop.report_bike_rental_document</field>
        <field name="binding_model_id" ref="model_bike_rental"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
