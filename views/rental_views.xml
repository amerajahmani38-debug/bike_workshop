<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_bike_rental_form" model="ir.ui.view">
        <field name="name">bike.rental.form</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <form string="Bike Rental">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" string="Return" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                           <field name="customer_id" options="{'no_create': False, 'no_create_edit': False}"/>                            <field name="bike_id"/>
                            <field name="daily_rental_price"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date" invisible="state != 'returned'"/>
                            <field name="rental_duration"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bike_rental_tree" model="ir.ui.view">
        <field name="name">bike.rental.tree</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <list string="Bike Rentals">
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="rental_duration"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_bike_rental_all" model="ir.actions.act_window">
        <field name="name">All Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bike_rental_confirmed" model="ir.actions.act_window">
        <field name="name">Confirmed Rentals</field>
        <field name="res_model">bike.rental</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_rental_root" 
              name="Rentals" 
              parent="menu_bike_workshop_root" 
              action="action_bike_rental_all" 
              sequence="20"/>

    <menuitem id="menu_bike_rental_all" 
              name="All Rentals" 
              parent="menu_bike_rental_root" 
              action="action_bike_rental_all" 
              sequence="10"/>

    <menuitem id="menu_bike_rental_confirmed" 
              name="Confirmed Rentals" 
              parent="menu_bike_rental_root" 
              action="action_bike_rental_confirmed" 
              sequence="20"/>
</odoo>