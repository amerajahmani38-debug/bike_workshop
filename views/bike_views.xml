<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Form View -->
    <record id="view_bike_form" model="ir.ui.view">
        <field name="name">bike.workshop.bike.form</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <form string="Bike">
                <header>
                    <button name="action_make_available" string="Make Available" type="object" class="oe_highlight"/>
                    <button name="action_make_rented" string="Rent Out" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,available,rented"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Mountain Bike 01"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="bike_type"/>
                            <field name="wheel_size"/>
                        </group>
                        <group>
                            <field name="daily_rental_price"/>
                            <field name="active"/>
                            <field name="bike_code"/>
                        </group>
                    </group>
                    <group string="Maintenance and Dates">
                        <group>
                            <field name="purchase_date"/>
                        </group>
                        <group>
                            <field name="last_maintenance_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bike_tree" model="ir.ui.view">
        <field name="name">bike.workshop.bike.tree</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <list string="Bikes">
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="daily_rental_price"/>
                <field name="state" widget="badge"/>
                <field name="purchase_date"/>
                <field name="last_maintenance_date"/>
                <field name="wheel_size"/>
            </list>
        </field>
    </record>

    <!-- Search View (المبسط والآمن بدون أخطاء) -->
    <record id="view_bike_search" model="ir.ui.view">
        <field name="name">bike.workshop.bike.search</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <search string="Bikes">
                <field name="name"/>
                <field name="brand"/>
            </search>
        </field>
    </record>

    <!-- Action (مع ربط الـ Search View) -->
    <record id="action_bike_workshop" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bike_search"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_workshop_root" 
              name="Bike Workshop"/>

    <menuitem id="menu_bike_management" 
              name="Bikes" 
              parent="menu_bike_workshop_root" 
              action="action_bike_workshop" 
              sequence="10"/>
</odoo>